rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.email != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.email.lower() == 'farahrifa58@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string &&
             id.size() >= 1 &&
             id.size() <= 128 &&
             id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function isValidCodeId(code) {
      return code is string &&
             code.size() >= 4 &&
             code.size() <= 64 &&
             code.matches('^[A-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    function isValidActivationCode(data) {
      return data.status is string && data.status in ['available', 'used'] &&
             (!('code' in data) || data.code == null || (data.code is string && data.code.size() <= 64)) &&
             (!('usedByBusinessName' in data) || data.usedByBusinessName == null || (data.usedByBusinessName is string && data.usedByBusinessName.size() <= 100)) &&
             (!('registeredDeviceId' in data) || data.registeredDeviceId == null || (data.registeredDeviceId is string && data.registeredDeviceId.size() <= 128)) &&
             (!('usedAt' in data) || data.usedAt == null || (data.usedAt is timestamp && data.usedAt <= request.time)) &&
             (!('createdAt' in data) || data.createdAt == null || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time)) &&
             (!('createdBy' in data) || data.createdBy == null || (data.createdBy is string && data.createdBy.size() <= 150)) &&
             (!('customerName' in data) || data.customerName == null || (data.customerName is string && data.customerName.size() <= 100)) &&
             (!('customerEmail' in data) || data.customerEmail == null || (data.customerEmail is string && data.customerEmail.size() <= 150)) &&
             (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 300));
    }

    function isOneTimeActivationTransition() {
      return existing().status == 'available' &&
             incoming().status == 'used' &&
             incoming().usedByBusinessName is string &&
             incoming().usedByBusinessName.size() >= 1 &&
             incoming().usedByBusinessName.size() <= 100 &&
             incoming().registeredDeviceId is string &&
             incoming().registeredDeviceId.size() >= 4 &&
             incoming().registeredDeviceId.size() <= 128 &&
             incoming().usedAt is timestamp &&
             incoming().usedAt <= request.time &&
             incoming().diff(existing()).affectedKeys().hasOnly([
               'status', 'usedByBusinessName', 'registeredDeviceId', 'usedAt'
             ]);
    }

    function isValidUserDoc(data) {
      return (!('uid' in data) || data.uid == null || (data.uid is string && data.uid.size() <= 128)) &&
             (!('userId' in data) || data.userId == null || (data.userId is string && data.userId.size() <= 128)) &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 150)) &&
             (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('name' in data) || data.name == null || (data.name is string && data.name.size() <= 100)) &&
             (!('businessName' in data) || data.businessName == null || (data.businessName is string && data.businessName.size() <= 100)) &&
             (!('storeName' in data) || data.storeName == null || (data.storeName is string && data.storeName.size() <= 100)) &&
             (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 30)) &&
             (!('address' in data) || data.address == null || (data.address is string && data.address.size() <= 250)) &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             (!('licenseCode' in data) || data.licenseCode == null || (data.licenseCode is string && data.licenseCode.size() <= 64)) &&
             (!('deviceId' in data) || data.deviceId == null || (data.deviceId is string && data.deviceId.size() <= 128)) &&
             (!('role' in data) || data.role == null || (data.role is string && data.role in ['user', 'admin'])) &&
             (!('status' in data) || data.status == null || (data.status is string && data.status.size() <= 40)) &&
             (!('isActive' in data) || data.isActive == null || data.isActive is bool) &&
             (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 300)) &&
             (!('createdAt' in data) || data.createdAt == null || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time)) &&
             (!('lastLoginAt' in data) || data.lastLoginAt == null || (data.lastLoginAt is timestamp && data.lastLoginAt <= request.time));
    }

    // --- Collection: activation_codes ---
    match /activation_codes/{code} {
      // Verified admin has full get access; regular users/devices can only check a specific
      // code that does not exist or is still "available" (protects used merchant/device PII)
      allow get: if isAdmin() || (
        isValidCodeId(code) &&
        (resource == null || resource.data.status == 'available')
      );

      // Only verified admin can list activation codes (prevents scraping/enumeration)
      allow list: if isAdmin();

      // Only verified admin can create new activation codes
      allow create: if isAdmin() &&
                       isValidId(code) &&
                       isValidActivationCode(incoming()) &&
                       incoming().keys().hasAll(['status']);

      // Verified admin has full update access; regular users/devices can perform a single
      // atomic one-time activation transition from "available" -> "used"
      allow update: if isValidActivationCode(incoming()) && (
        (isAdmin() && isValidId(code)) ||
        (isValidCodeId(code) && isOneTimeActivationTransition())
      );

      // Only verified admin can delete activation codes
      allow delete: if isAdmin() && isValidId(code);
    }

    // --- Collection: users ---
    match /users/{userId} {
      // Verified admin has full read/list access; authenticated users can only read their own profile
      allow get: if isAdmin() || (isValidId(userId) && isOwner(userId));
      allow list: if isAdmin();

      // Verified admin can create any valid user record; authenticated users can only create
      // their own profile without self-assigning admin roles/privileges
      allow create: if isValidId(userId) &&
                       isValidUserDoc(incoming()) && (
                         isAdmin() || (
                           isOwner(userId) &&
                           (!('uid' in incoming()) || incoming().uid == request.auth.uid) &&
                           (!('userId' in incoming()) || incoming().userId == request.auth.uid) &&
                           incoming().keys().hasOnly([
                             'uid', 'userId', 'email', 'displayName', 'name',
                             'businessName', 'storeName', 'phone', 'address',
                             'photoUrl', 'licenseCode', 'deviceId',
                             'createdAt', 'updatedAt', 'lastLoginAt'
                           ])
                         )
                       );

      // Verified admin has full update access; authenticated users can only update their own
      // allowed profile fields while keeping immutable/RBAC fields untouched
      allow update: if isValidId(userId) &&
                       isValidUserDoc(incoming()) && (
                         isAdmin() || (
                           isOwner(userId) &&
                           (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
                           (!('uid' in existing()) || incoming().uid == existing().uid) &&
                           (!('userId' in existing()) || incoming().userId == existing().userId) &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'displayName', 'name', 'businessName', 'storeName',
                             'phone', 'address', 'photoUrl', 'licenseCode',
                             'deviceId', 'updatedAt', 'lastLoginAt'
                           ])
                         )
                       );

      // Verified admin or document owner can delete user document
      allow delete: if isValidId(userId) && (isAdmin() || isOwner(userId));

      // Allow verified admin full access to any subcollections under users/{userId}
      match /{document=**} {
        allow read, write: if isAdmin();
      }
    }
  }
}
